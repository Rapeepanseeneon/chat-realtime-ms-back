PORT=3001
DATABASE_URL=postgresql://username:password@localhost:5432/chat_realtime
DATABASE_POOL_SIZE=5
# Tests never fall back to DATABASE_URL. Create this database manually first.
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/pb_messenger_test
DEVELOPMENT_BACKEND_PORT=3001
TEST_BACKEND_PORT=3101
CHAT_TEST_API_URL=http://localhost:3101
TEST_BACKEND_HTTPS=false
TEST_ATTACHMENT_STORAGE_DIR=storage/test-attachments
FRONTEND_URL=http://localhost:3000
# Optional comma-separated allowlist. When set, this takes precedence over FRONTEND_URL.
FRONTEND_URLS=http://localhost:3000,https://localhost:3000
# Development-only TLS. Paths may be absolute or relative to the backend working directory.
DEV_HTTPS=false
TLS_CERT_PATH=
TLS_KEY_PATH=
COOKIE_SECURE=false
TRUST_PROXY=false
# Retired by default. Enable only while supporting a known legacy global-chat client.
ENABLE_LEGACY_GLOBAL_CHAT=false
ATTACHMENT_STORAGE_DIR=storage/attachments
