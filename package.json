{
  "name": "chat-realtime-ms-back",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "test:unit": "bun test tests/test-database-safety.test.ts tests/attachment-storage.test.ts tests/security-perimeter.test.ts tests/migration-foundation.test.ts",
    "test:integration:backend": "bun run scripts/start-test-backend.ts",
    "test:integration": "bun test",
    "db:migrate": "bun run scripts/database-migrations.ts migrate",
    "db:migrate:test": "bun run scripts/database-migrations.ts migrate --test",
    "db:status": "bun run scripts/database-migrations.ts status",
    "db:status:test": "bun run scripts/database-migrations.ts status --test",
    "build": "bun build ./src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "hono": "4.13.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
